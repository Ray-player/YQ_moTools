{
  "$meta": {
    "name": "YQRec UI · 扁平简约",
    "version": "1.0.0",
    "date": "2026-10-21",
    "source_of_truth": "templates/theme.py（本文件由它同步而来，两者必须一致）",
    "note": "颜色值是 sRGB 十六进制；overlay 段两套主题共用（画在游戏画面上，不随主题变）。默认主题 = 日间（light），可在设置里切到 dark。",
    "default_theme": "light"
  },
  "geometry": {
    "radius": {
      "control": 6,
      "segment": 4,
      "chip": 4,
      "card": 8,
      "pill": 6
    },
    "height": {
      "button": 26,
      "combo": 26,
      "input_row": 26,
      "icon_button": 26,
      "statusbar": 26,
      "section_header": 28
    },
    "spacing": {
      "unit": 4,
      "toolbar_row": 6,
      "toolbar_gap": 4,
      "toolbar_padding": "8 6 8 6",
      "card_padding": 8,
      "key_grid": 4
    },
    "splitter": {
      "handle": 8
    },
    "typography": {
      "ui_family": "Microsoft YaHei UI, Microsoft YaHei, Segoe UI",
      "mono_family": "Consolas, Cascadia Mono, monospace",
      "size": {
        "body": 12,
        "section_title": 12,
        "meta": 11,
        "micro": 10,
        "key_name": 11,
        "key_metric": 9,
        "record": 12,
        "status": 11
      }
    }
  },
  "themes": {
    "dark": {
      "label": "夜间",
      "bg-canvas": "#0E1216",
      "bg-panel": "#141A20",
      "bg-surface": "#1B222A",
      "bg-surface-hover": "#232C35",
      "bg-surface-active": "#2A343E",
      "bg-input": "#0B0F13",
      "bg-elevated": "#1A222B",
      "border-subtle": "#222B34",
      "border-default": "#2F3A45",
      "border-strong": "#3D4A57",
      "text-primary": "#E3EAF2",
      "text-secondary": "#9DABBA",
      "text-tertiary": "#75828F",
      "text-disabled": "#4C5764",
      "accent": "#2A66F0",
      "accent-hover": "#3B76FF",
      "accent-pressed": "#1E52CC",
      "accent-fg": "#FFFFFF",
      "accent-soft": "#16233A",
      "accent-border": "#4B83F0",
      "accent-text": "#7FAAFF",
      "success": "#2ED47F",
      "success-fg": "#06140C",
      "success-soft": "#14301F",
      "danger": "#FF6B6B",
      "danger-fg": "#1A0808",
      "danger-soft": "#35191B",
      "warn": "#F0A93B",
      "warn-soft": "#35290F"
    },
    "light": {
      "label": "日间",
      "bg-canvas": "#F4F6F8",
      "bg-panel": "#FFFFFF",
      "bg-surface": "#EFF2F5",
      "bg-surface-hover": "#E6EAEF",
      "bg-surface-active": "#DCE2E9",
      "bg-input": "#FFFFFF",
      "bg-elevated": "#FFFFFF",
      "border-subtle": "#E4E9EE",
      "border-default": "#D3DAE2",
      "border-strong": "#B9C3CE",
      "text-primary": "#18202A",
      "text-secondary": "#5A6675",
      "text-tertiary": "#67737F",
      "text-disabled": "#A7B1BC",
      "accent": "#2563EB",
      "accent-hover": "#1D4ED8",
      "accent-pressed": "#1A44B8",
      "accent-fg": "#FFFFFF",
      "accent-soft": "#E9F0FE",
      "accent-border": "#93B4FA",
      "accent-text": "#1D4ED8",
      "success": "#17B26A",
      "success-fg": "#04150C",
      "success-soft": "#E4F7ED",
      "danger": "#D92D20",
      "danger-fg": "#FFFFFF",
      "danger-soft": "#FDECEA",
      "warn": "#B45309",
      "warn-soft": "#FEF3E2"
    }
  },
  "overlay": {
    "ring": "rgba(255,255,255,0.55)",
    "ring-strong": "rgba(255,255,255,0.95)",
    "press-edge": "rgba(46,212,127,0.95)",
    "press-fill": "rgba(46,212,127,0.14)",
    "dot": "rgba(255,120,120,0.45)",
    "dot-strong": "rgba(255,92,92,0.95)",
    "guide": "rgba(150,195,255,0.22)",
    "edit-fill": "rgba(46,212,127,0.16)",
    "edit-edge": "rgba(120,240,170,0.95)",
    "edit-sel-fill": "rgba(255,200,60,0.22)",
    "edit-sel-edge": "rgba(255,200,60,1.0)",
    "chip-bg": "rgba(10,14,18,0.72)",
    "chip-text": "rgba(232,240,248,0.92)",
    "scrim": "rgba(8,10,14,0.50)",
    "select-fill": "rgba(42,102,240,0.18)",
    "select-edge": "rgba(90,148,255,1.0)",
    "select-label-bg": "rgba(10,14,18,0.78)",
    "select-label-text": "rgba(232,240,248,0.95)"
  },
  "contrast": {
    "method": "WCAG 2.1 relative luminance",
    "min_normal_text": 4.5,
    "min_large_text": 3.0,
    "checked": [
      {
        "pair": "dark: text-primary / bg-canvas",
        "ratio": 15.3
      },
      {
        "pair": "dark: text-secondary / bg-panel",
        "ratio": 8.0
      },
      {
        "pair": "dark: text-tertiary / bg-panel",
        "ratio": 4.7
      },
      {
        "pair": "dark: accent-fg / accent",
        "ratio": 4.9
      },
      {
        "pair": "dark: success-fg / success",
        "ratio": 8.6
      },
      {
        "pair": "dark: accent-text / accent-soft",
        "ratio": 6.4
      },
      {
        "pair": "light: text-primary / bg-panel",
        "ratio": 14.6
      },
      {
        "pair": "light: text-secondary / bg-panel",
        "ratio": 5.9
      },
      {
        "pair": "light: text-tertiary / bg-panel",
        "ratio": 4.9
      },
      {
        "pair": "light: accent-fg / accent",
        "ratio": 5.1
      },
      {
        "pair": "light: success-fg / success",
        "ratio": 7.4
      },
      {
        "pair": "light: accent-text / accent-soft",
        "ratio": 6.8
      }
    ]
  }
}
